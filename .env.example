# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# Gemini API keys — comma-separated list of keys for automatic failover/rotation
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3
GEMINI_API_KEY=

# Optional: override the model name (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Backend host/port (defaults shown)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Marketaux API keys — comma-separated list of keys for automatic failover/rotation
MARKETAUX_API_KEYS=your_marketaux_key_1,your_marketaux_key_2,your_marketaux_key_3
MARKETAUX_API_KEY=
